{
  "name": "@helaengine/asset-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ingest pipeline: raw GLB sources in, compressed GLBs + thumbnails + manifest out.",
  "scripts": {
    "generate-raw": "tsx src/generate-raw-assets.ts && tsx src/generate-raw-audio.ts",
    "ingest": "tsx src/ingest-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "import-pack": "tsx src/import-pack-cli.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@helaengine/schema": "workspace:*",
    "draco3dgltf": "^1.5.7",
    "three": "^0.185.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "tsx": "^4.23.9",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
