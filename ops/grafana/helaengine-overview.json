{
  "title": "helaengine — overview",
  "uid": "helaengine-overview",
  "tags": ["helaengine"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API latency (p50 / p95 / p99)",
      "description": "The three that answer different questions: p50 is the typical experience, p95 is what an SLA is written against, p99 is the tail that a big customer lives in.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(hela_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hela_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hela_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate by route",
      "description": "5xx only. 4xx is on its own panel because mixing them makes an expired-session storm look like an outage.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (route) (rate(hela_http_requests_total{status=\"5xx\"}[5m])) / sum by (route) (rate(hela_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests by route and status class",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (route, status) (rate(hela_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Export queue depth",
      "description": "`waiting` is the one that means a user's export has not started. `active` above concurrency means more than one worker is running, which is how this scales.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "hela_export_queue_depth",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Export job duration (p50 / p95)",
      "description": "Successes and failures are separate series on purpose: a failure that fails fast would otherwise flatter the average.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, outcome) (rate(hela_export_job_duration_seconds_bucket[15m])))",
          "legendFormat": "p50 {{outcome}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(hela_export_job_duration_seconds_bucket[15m])))",
          "legendFormat": "p95 {{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Postgres pool",
      "description": "`waiting` above zero means requests are queueing inside the pool — the API is slow with no slow query to point at.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "hela_pg_pool_connections",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Exports built (24h)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(increase(hela_export_jobs_total{outcome=\"done\"}[24h]))",
          "legendFormat": "done"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Exports failed (24h)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(increase(hela_export_jobs_total{outcome=\"failed\"}[24h]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requests in flight",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "hela_http_in_flight_requests", "legendFormat": "in flight" }]
    }
  ]
}
