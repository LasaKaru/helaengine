{
  "name": "@helaengine/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accounts, organisations and role-gated access. The platform every later backend feature builds on.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@helaengine/schema": "workspace:*",
    "bullmq": "^6.3.1",
    "ioredis": "^5.4.1",
    "pg": "^8.23.0",
    "zod": "^3.24.1",
    "@helaengine/telemetry": "workspace:*",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  }
}
