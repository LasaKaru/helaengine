{
  "name": "@helaengine/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HelaEngine editor — React + react-three-fiber shell around the engine runtime.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "PW_BROWSERS=chromium playwright test",
    "e2e:export": "xvfb-run -a playwright test export-qa"
  },
  "dependencies": {
    "@helaengine/engine": "workspace:*",
    "@helaengine/export": "workspace:*",
    "@helaengine/schema": "workspace:*",
    "@helaengine/templates": "workspace:*",
    "@react-three/drei": "^9.120.4",
    "@react-three/fiber": "^8.17.10",
    "colyseus.js": "0.15.26",
    "dexie": "^4.4.4",
    "immer": "^10.1.1",
    "jszip": "3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^2.3.0",
    "three": "^0.172.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "pixelmatch": "6.0.0",
    "pngjs": "7.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
