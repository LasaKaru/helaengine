{
  "name": "helaengine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "demo": "pnpm --filter @helaengine/demo dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-assets": "pnpm --filter @helaengine/asset-pipeline generate-raw",
    "ingest-assets": "pnpm --filter @helaengine/asset-pipeline ingest",
    "editor": "pnpm --filter @helaengine/editor dev",
    "e2e": "pnpm --filter @helaengine/editor e2e",
    "bench": "node tools/benchmark/run.mjs",
    "smoke": "pnpm --filter @helaengine/smoke smoke",
    "smoke:test": "pnpm --filter @helaengine/smoke smoke:test",
    "api": "pnpm --filter @helaengine/api start",
    "portable": "pnpm --filter @helaengine/editor build && node tools/portable/build.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
